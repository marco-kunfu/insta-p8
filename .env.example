# ---- Database (Prisma sobre el Postgres de Supabase) ----
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# DATABASE_URL: pooled (puerto 6543, pgbouncer). DIRECT_URL: directa (5432),
# usada por prisma db push / migrate.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Kunfupay Integration (KunfuApp — APIs externas) ----
# Credenciales de la app (Developer Tools -> Credenciales -> Generar).
# Identifican a la KunfuApp; el usuario se resuelve con el embed_token de
# cada sesión (cabecera X-Kunfupay-Embed-Token). Solo backend, nunca en el
# iframe/navegador.
KUNFUPAY_API_URL="https://api.kunfupay.com/api/v1"
KUNFUPAY_CLIENT_ID="kfp_..."
KUNFUPAY_CLIENT_SECRET="kfs_..."
KUNFUPAY_WEBHOOK_SIGNING_KEY="whsec_..."
# Verificación del embed_token (POST /public/embed/verify) — host business.
KUNFUPAY_API_BASE="https://business.kunfupay.com/api/v1"

# ---- App Config ----
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# ---- Instagram / Meta App ----
# This app uses "Instagram API with Instagram Login" (Business Login) — NOT Instagram
# Basic Display and NOT Facebook Login. Dashboard: https://developers.facebook.com/apps/
#   -> Your App -> Instagram -> API setup with Instagram business login
#
# App ID / secret: use the *Instagram app ID* and *Instagram app secret* shown on that
# Instagram product page — NOT the parent Meta app ID from Settings -> Basic.
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: parent Meta app secret (Settings -> Basic). Only needed if webhook signature
# validation fails with 401s because Meta signs deliveries with the parent app secret.
META_APP_SECRET=
# Must exactly match one of the "OAuth redirect URIs" in Instagram -> Business login settings
# (character-for-character: scheme, host, path, no trailing slash mismatch).
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3003/api/instagram/callback
# Any random string; enter the same value in the webhook subscription form in the dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---- AI Auto-Reply (optional — enables the AI toggle in Automations) ----
# Get a free Groq key at https://console.groq.com (recommended, fast + free)
# Or use any OpenAI-compatible provider: set AI_BASE_URL + AI_MODEL + one of the keys below
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.1-8b-instant
